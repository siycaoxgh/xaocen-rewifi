<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>XAOCEN-ReWiFi</AssemblyName>
    <Product>XAOCEN ReWiFi</Product>
    <AssemblyTitle>XAOCEN ReWiFi</AssemblyTitle>
    <Title>XAOCEN ReWiFi</Title>
    <Company>XAOCEN STUDIO</Company>
    <RootNamespace>XAOCEN.ReWiFi</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <Version>2.3</Version>
    <InformationalVersion>2.3</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
    <FileVersion>2.3.0.0</FileVersion>
    <!-- A build-only revision keeps same public versions distinguishable during portable upgrades. -->
    <BuildRevision Condition="'$(BuildRevision)' == ''">$([System.DateTime]::UtcNow.Ticks)</BuildRevision>
    <ApplicationIcon>Assets\xaocen-rewifi_rounded.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TelemetryTest)' == 'true'">
    <DefineConstants>$(DefineConstants);TELEMETRY_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>XAOCEN-BuildRevision</_Parameter1>
      <_Parameter2>$(BuildRevision)</_Parameter2>
    </AssemblyAttribute>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.1" />
    <EmbeddedResource Include="Assets\xaocen-rewifi_rounded.png" />
    <EmbeddedResource Include="Assets\About.html" />
    <EmbeddedResource Include="Assets\terms.html" />
    <EmbeddedResource Include="Assets\privacy.html" />
    <EmbeddedResource Include="Assets\xaocen-rewifi.png" />
    <Compile Remove="QrScannerForm.cs;QrCodeForm.cs;QrCodeService.cs" />
  </ItemGroup>

</Project>
